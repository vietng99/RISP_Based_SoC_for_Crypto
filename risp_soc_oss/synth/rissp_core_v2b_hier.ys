# [t-033] RISSP v2b area per block: synthesis without -flatten (hierarchy kept), for the per-block breakdown only.
read_verilog rtl/cores/rissp_v2b/rissp_top.v rtl/cores/rissp_v2b/fetch_stage.v rtl/cores/rissp_v2b/register_file.v rtl/cores/rissp_v2b/modular_ex.v rtl/cores/rissp_v2b/alu_adder.v rtl/cores/rissp_v2b/u_type_block.v rtl/cores/rissp_v2b/i_type_block.v rtl/cores/rissp_v2b/r_type_block.v rtl/cores/rissp_v2b/s_type_block.v rtl/cores/rissp_v2b/b_type_block.v rtl/cores/rissp_v2b/j_type_block.v rtl/cores/rissp_v2b/axi_rissp_master.v
synth_xilinx -family xc7 -top rissp_top
tee -o logs/synth-rissp_v2b-hier-stat.txt stat
