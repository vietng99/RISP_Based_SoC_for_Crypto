# Resources of the RSA accelerator exactly as installed in ip_repo (PA1-R, t-012).
read_verilog ../RISP_SoC_6projects/RISP/ip_repo/acc_rsa/src/RSA_core.v
read_verilog ../RISP_SoC_6projects/RISP/ip_repo/acc_rsa/hdl/RSA_mark03_slave_lite_v1_0_S00_AXI.v
hierarchy -top RSA_mark03_slave_lite_v1_0_S00_AXI -chparam RSA_WIDTH 2048
synth_xilinx -family xc7 -flatten -top RSA_mark03_slave_lite_v1_0_S00_AXI
tee -o logs/synth-rsa-iprepo.stat stat
